# ==============================================================================
# Coffee Adda Backend - Environment Configuration Template (.env.example)
# Copy this file to .env and customize values for your deployment.
# ==============================================================================

# Core & Security Settings
# In production, generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=generate_a_unique_secure_secret_key_for_production
DEBUG=False

# Allowed Hostnames (comma-separated, without wildcards in production)
ALLOWED_HOSTS=localhost,127.0.0.1,coffee-adda.vercel.app,your-domain.com

# Database Configuration (PostgreSQL or SQLite)
# Option A: Full Connection URL (Neon, Supabase, AWS RDS, Railway, Render)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option B: Discrete Parameters
DB_ENGINE=django.db.backends.postgresql
DB_NAME=coffee_adda_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# To use SQLite for local development:
# DB_ENGINE=django.db.backends.sqlite3

# Staff Admin Superuser Provisioning (Optional / Initial Setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change_this_to_a_strong_password
DJANGO_SUPERUSER_EMAIL=admin@coffeeadda.com
