# ==============================================================================
# Coffee Adda - Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=coffee_adda_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Alternative full connection string (Neon, Supabase, AWS RDS, local):
# DATABASE_URL=postgres://postgres:your_postgres_password_here@localhost:5432/coffee_adda_db

# Django Core & Security Settings
SECRET_KEY=django-insecure-coffee-adda-budhanilkantha-artisan-roast-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,coffee-adda.vercel.app

# Staff Admin Superuser Provisioning
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=your_admin_password_here
DJANGO_SUPERUSER_EMAIL=admin@coffeeadda.com
